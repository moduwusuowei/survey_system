{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "backend/app/main.py": {
      "runtime": "@vercel/python@3.0.0"
    }
  },
  "routes": [
    {
      "src": "/((?!api|_next|static|favicon.ico).*)",
      "dest": "/index.html"
    },
    {
      "src": "/api/(.*)",
      "dest": "backend/app/main.py"
    }
  ]
}